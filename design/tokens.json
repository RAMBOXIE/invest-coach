{
  "_note": "设计令牌单一真源。CSS 变量由 build.py 生成，源码不许出现字面色值与字面字号。层级：primitive → semantic → component。",
  "primitive": {
    "color": {
      "night-900": "#0B0F1A",
      "night-800": "#141B36",
      "night-700": "#232E52",
      "paper-50": "#FBF7EE",
      "paper-100": "#F3EAD6",
      "paper-200": "#E2D8C4",
      "ink-900": "#2B2540",
      "ink-700": "#37304D",
      "ink-500": "#5D5674",
      "mist-400": "#A9B0C2",
      "mist-300": "#C6CBD8",
      "gold-400": "#FFD166",
      "violet-500": "#8646B8",
      "green-500": "#1F7A4C",
      "red-500": "#B03246",
      "blue-500": "#1F6BA8"
    },
    "size": {
      "13": "13px",
      "15": "15px",
      "17": "17px",
      "19": "19px",
      "24": "24px",
      "32": "32px",
      "40": "40px",
      "56": "56px"
    },
    "lh": {
      "tight": "1.35",
      "ui": "1.6",
      "read": "1.85"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "8": "56px"
    },
    "radius": {
      "sm": "10px",
      "md": "14px",
      "lg": "20px",
      "pill": "999px"
    },
    "dur": {
      "micro": "160ms",
      "trans": "360ms"
    }
  },
  "semantic": {
    "surface": {
      "stage": "{color.night-900}",
      "shell": "{color.night-800}",
      "read": "{color.paper-50}",
      "read-alt": "{color.paper-100}"
    },
    "text": {
      "narrative": {
        "color": "{color.paper-50}",
        "size": "clamp(17px,4.6vw,19px)",
        "lh": "{lh.read}",
        "_contrast_on_stage": "15.8:1"
      },
      "body": {
        "color": "{color.ink-700}",
        "size": "{size.17}",
        "lh": "{lh.read}",
        "_contrast_on_read": "9.1:1"
      },
      "ui": {
        "color": "{color.paper-50}",
        "size": "{size.15}",
        "lh": "{lh.ui}"
      },
      "meta": {
        "color": "{color.mist-400}",
        "size": "{size.13}",
        "lh": "{lh.ui}",
        "_contrast_on_shell": "8.8:1",
        "_replaces": "#7b749b (3.86:1, 违反 WCAG 1.4.3 AA)"
      },
      "epic": {
        "color": "{color.gold-400}",
        "size": "clamp(32px,9vw,56px)",
        "lh": "{lh.tight}"
      }
    },
    "state": {
      "flag": "{color.red-500}",
      "clear": "{color.green-500}",
      "unknown": "{color.blue-500}",
      "focus": "{color.gold-400}"
    },
    "measure": {
      "read": "34em",
      "_note": "中文每行 20–30 字上限"
    },
    "tap": {
      "min": "44px",
      "rec": "48px",
      "gap": "{space.2}"
    }
  },
  "budget": {
    "dist_kb": 300,
    "lcp_ms": 2500,
    "inp_ms": 200,
    "cls": 0.1,
    "fps_min": 50
  },
  "banned": [
    "background-attachment:fixed",
    "全屏位图/视频",
    "自定义中文正文字体",
    "滚动劫持",
    "横向滑动承载主流程",
    "打字机逐字动画",
    "视差"
  ],
  "epic_allowlist": [
    "超大字号阶梯",
    "大留白",
    "内联 SVG 线条与时间轴",
    "CSS 渐变与噪点",
    "≤200ms 微动效",
    "竖向滚动叙事",
    "原档等宽字体+行号+高亮带"
  ]
}