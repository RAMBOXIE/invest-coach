{
  "_note": "设计令牌单一真源。CSS 变量由 build.py 生成，源码不许出现字面色值与字面字号（门禁 tools/check_tokens.py 执行）。层级：primitive → semantic → component。",
  "_version": "v2 · 纸面翻正",
  "_decision": "纸是主场，暗色只给「幕」。判卷台/目录/图谱/进度/教练全部在纸面上；叙事段落进暗场。明暗切换本身就是章节节拍器。完整理由见 DESIGN.md。",
  "primitive": {
    "font": {
      "ui": "\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",\"Noto Sans SC\",system-ui,sans-serif",
      "display": "\"PingFang SC\",\"Microsoft YaHei\",\"Hiragino Sans GB\",\"Noto Sans SC\",system-ui,sans-serif",
      "mono": "ui-monospace,\"SF Mono\",Menlo,Consolas,\"Noto Sans Mono CJK SC\",monospace",
      "_note": "display 与 ui 是同一套无衬线——中文没有拉丁那种衬线/无衬线的阅读惯例分工，展示层的对比靠字号 + 字重 + 字距，不靠换字族。v2.0 曾用系统衬线，实测在 Windows 上落到 SimSun（为 12px 点阵设计），32px 下难看；且 Songti SC / PingFang SC 都是 macOS 专有，Windows 一律 fallback。mono 用 Consolas/SF Mono，那是功能性的（原档数字对齐），不是装饰。"
    },
    "color": {
      "night-900": "#0B0F1A",
      "night-800": "#141B36",
      "night-700": "#232E52",
      "paper-50": "#FBF7EE",
      "paper-100": "#F3EAD6",
      "paper-200": "#E2D8C4",
      "ink-900": "#2B2540",
      "ink-700": "#37304D",
      "ink-500": "#5D5674",
      "mist-400": "#A9B0C2",
      "mist-300": "#C6CBD8",
      "gold-400": "#FFD166",
      "amber-700": "#7A5300",
      "violet-500": "#7C3FAC",
      "green-600": "#1A6B42",
      "red-500": "#A82D40",
      "blue-500": "#1B5F96",
      "red-wash": "#FDE8EA",
      "green-wash": "#E8F8EF",
      "amber-wash": "#FFF2D9",
      "blue-wash": "#E9F3FC",
      "rule-on-stage": "rgba(255,209,102,0.30)",
      "_retired": {
        "green-500": "#1F7A4C — 在 paper-100 上只有 4.45:1，压线不过，换 green-600",
        "gold-on-paper": "gold-400 在 paper-50 上只有 1.35:1，纸面强调一律用 amber-700",
        "amber-8A5E00": "amber-700 旧值 #8A5E00 —— 在 paper-200（外壳渐变的深端）只有 4.03:1，压低为 #7A5300",
        "red-B03246": "red-500 旧值 #B03246 —— 在 paper-200 只有 4.38:1",
        "blue-1F6BA8": "blue-500 旧值 #1F6BA8 —— 在 paper-200 只有 3.99:1",
        "violet-8646B8": "violet-500 旧值 #8646B8 —— 在 paper-200 只有 4.15:1"
      },
      "violet-wash": "#F1EBFA",
      "violet-300": "#CBB6E6",
      "violet-700": "#5C3A80"
    },
    "size": {
      "13": "13px",
      "15": "15px",
      "17": "17px",
      "19": "19px",
      "24": "24px",
      "32": "32px",
      "40": "40px",
      "56": "56px"
    },
    "lh": {
      "tight": "1.12",
      "snug": "1.35",
      "ui": "1.6",
      "read": "1.85"
    },
    "weight": {
      "normal": "400",
      "medium": "600",
      "display": "700"
    },
    "track": {
      "display": "-0.02em",
      "eyebrow": "0.24em",
      "none": "0"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "8": "56px",
      "10": "88px"
    },
    "radius": {
      "sm": "10px",
      "md": "14px",
      "lg": "20px",
      "pill": "999px"
    },
    "dur": {
      "micro": "160ms",
      "trans": "360ms"
    }
  },
  "semantic": {
    "surface": {
      "shell": "{color.paper-100}",
      "shell-alt": "{color.paper-200}",
      "card": "{color.paper-50}",
      "rule": "{color.paper-200}",
      "stage": "{color.night-900}",
      "stage-alt": "{color.night-800}",
      "read": "{color.paper-50}",
      "read-alt": "{color.paper-100}",
      "_flip": "v1 里 shell=night-800（暗为主场）。v2 翻正：shell=paper-100，卡片 paper-50 抬起。stage 保持暗——幕是唯一的暗场。"
    },
    "text": {
      "display": {
        "font": "{font.display}",
        "weight": "{weight.display}",
        "track": "{track.display}",
        "color": "{color.ink-900}",
        "size": "clamp(32px,9vw,56px)",
        "lh": "{lh.tight}",
        "_contrast_on_shell": "12.18:1",
        "_note": "幕标题与章节大字。v1 定义了 size.56 却一次没用，全站最大字号卡在 20px——这是「没有层次」的根因。"
      },
      "title": {
        "font": "{font.display}",
        "weight": "{weight.display}",
        "track": "{track.display}",
        "color": "{color.ink-900}",
        "size": "{size.24}",
        "lh": "{lh.snug}",
        "_contrast_on_shell": "12.18:1"
      },
      "body": {
        "font": "{font.ui}",
        "color": "{color.ink-700}",
        "size": "{size.17}",
        "lh": "{lh.read}",
        "_contrast_on_shell": "10.37:1",
        "_contrast_on_card": "11.61:1"
      },
      "ui": {
        "font": "{font.ui}",
        "color": "{color.ink-700}",
        "size": "{size.15}",
        "lh": "{lh.ui}",
        "_contrast_on_shell": "10.37:1"
      },
      "meta": {
        "font": "{font.ui}",
        "color": "{color.ink-500}",
        "size": "{size.13}",
        "lh": "{lh.ui}",
        "_contrast_on_shell": "5.76:1",
        "_contrast_on_card": "6.44:1",
        "_replaces": "template.html 的 --soft #6f688a（on night-800 = 3.24:1，实测页面 3.67:1，均低于 AA 4.5）。v1 的 tokens 已把这个 bug 记为「已修复为 mist-400」，但页面从未采用，门禁读令牌所以一直报 PASS。"
      },
      "figure": {
        "font": "{font.mono}",
        "color": "{color.ink-900}",
        "size": "{size.15}",
        "lh": "{lh.ui}",
        "_note": "原档数字、行号、EDGAR 引用。等宽是出处可信度的视觉凭证——数字对得齐，才像账本。"
      },
      "narrative": {
        "font": "{font.ui}",
        "color": "{color.paper-50}",
        "size": "clamp(17px,4.6vw,19px)",
        "lh": "{lh.read}",
        "_contrast_on_stage": "17.90:1"
      },
      "meta-on-stage": {
        "color": "{color.mist-400}",
        "size": "{size.13}",
        "_contrast_on_stage": "8.82:1"
      }
    },
    "state": {
      "flag": "{color.red-500}",
      "clear": "{color.green-600}",
      "unknown": "{color.blue-500}",
      "focus": "{color.amber-700}",
      "focus-on-stage": "{color.gold-400}",
      "flag-on-stage": "#FF8FA0",
      "_note": "focus 在纸面用 amber-700（paper-50 6.41 / paper-100 5.73 / paper-200 4.85），在幕上用 gold-400（13.27:1）。同一个语义，两个场各一个值。amber-700 曾是 #8A5E00，在外壳渐变最深的 paper-200 一端只有 4.03:1，实测顶栏 eyebrow 4.12:1。",
      "press": "rgba(43,37,64,0.12)",
      "press-on-stage": "rgba(251,247,238,0.16)",
      "_press_note": "按下态。* 里关掉了 -webkit-tap-highlight-color，不自己补的话手机上点任何东西都是零反应——v2.1 之前全站一条 :active 都没有。用 inset 阴影而非改 background：盖在任何底上都成立，且不参与布局。"
    },
    "brand": {
      "violet": "{color.violet-500}",
      "_contrast_on_shell": "4.90:1"
    },
    "measure": {
      "read": "34em",
      "_note": "中文每行 20–30 字上限"
    },
    "tap": {
      "min": "44px",
      "rec": "48px",
      "gap": "{space.2}"
    }
  },
  "budget": {
    "dist_kb": 2048,
    "lcp_ms": 2500,
    "inp_ms": 200,
    "cls": 0.1,
    "fps_min": 50,
    "gzip_trigger_kb": 500
  },
  "banned": [
    "background-attachment:fixed",
    "全屏位图/视频",
    "自定义中文正文字体",
    "滚动劫持",
    "横向滑动承载主流程",
    "打字机逐字动画",
    "视差",
    "emoji 当图标",
    "源码字面色值与字面字号"
  ],
  "epic_allowlist": [
    "超大字号阶梯",
    "大留白",
    "内联 SVG 线条与时间轴",
    "CSS 渐变与噪点",
    "≤200ms 微动效",
    "竖向滚动叙事",
    "原档等宽字体+行号+高亮带",
    "纸↔幕的明暗切换作为章节节拍"
  ]
}
